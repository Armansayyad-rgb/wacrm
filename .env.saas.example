# FlowCRM SaaS additions. Combine these with the existing .env.local.example values.

# Public branding
NEXT_PUBLIC_APP_NAME=FlowCRM
NEXT_PUBLIC_APP_TAGLINE=Turn WhatsApp conversations into leads, follow-ups, and sales.
NEXT_PUBLIC_SITE_URL=https://app.example.com

# Paddle billing. Use sandbox while integrating.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=replace-me
PADDLE_WEBHOOK_SECRET=replace-me
PADDLE_PRICE_STARTER_MONTHLY=pri_replace_me
PADDLE_PRICE_BUSINESS_MONTHLY=pri_replace_me
PADDLE_PRICE_PRO_MONTHLY=pri_replace_me
PADDLE_CHECKOUT_URL=https://app.example.com/settings?tab=billing
